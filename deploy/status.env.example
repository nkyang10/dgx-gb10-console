# /etc/dgx-status/status.env  (created by scripts/install.sh; chmod 600, owned root)
#
# This file holds secrets and runtime overrides for the systemd unit / container.
# It is the ONLY place the auth token and bind port come from.

# Shared cluster auth token (must match on aggregator + all exporters).
# Generate:  openssl rand -hex 32
DGX_STATUS_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Bind port for the uvicorn process (default 9101)
DGX_STATUS_PORT=9101

# Node role: aggregator | exporter   (this node)
DGX_STATUS_ROLE=aggregator

# Optional: override config.yaml node.mgmt_ip
DGX_STATUS_MGMT_IP=10.0.20.10
